# Runtime image for the Nimbus VM.
#
# The jar is Java bytecode and therefore architecture independent: it is built
# once on a bigger machine and assembled here against a native arm64 base. No
# Maven and no emulation, neither of which a 2GB box can afford.
#
# Base is debian-slim plus Debian's own JRE rather than eclipse-temurin: the
# temurin arm64 image fails to exec on this kernel ("input/output error"),
# while debian and ubuntu bases run fine.
FROM debian:trixie-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends openjdk-21-jre-headless curl \
 && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10001 nimbus \
 && useradd  --system --uid 10001 --gid nimbus --shell /usr/sbin/nologin --no-create-home nimbus \
 && mkdir -p /var/nimbus/sites \
 && chown -R 10001:10001 /var/nimbus \
 && chmod 755 /var/nimbus /var/nimbus/sites

WORKDIR /app
COPY app.jar /app/app.jar
RUN chmod 444 /app/app.jar

USER 10001:10001
EXPOSE 8080

ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/urandom"

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=5 \
  CMD curl -fsS http://127.0.0.1:8080/actuator/health | grep -q UP || exit 1

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
