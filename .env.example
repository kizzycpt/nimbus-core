# Copy to .env and fill in — or just run ./run.sh, which generates a .env
# with strong random secrets on first run.
#
# .env holds live credentials and is gitignored. Never commit it.

# --- Postgres (runs in its own container, never exposed to the host) ---
POSTGRES_DB=nimbus
POSTGRES_USER=nimbus
POSTGRES_PASSWORD=          # >= 16 chars, generated. Do not reuse a personal password.

# --- JWT ---
JWT_SECRET=                 # >= 32 chars for HS256. Rotating this invalidates all issued tokens.
JWT_EXPIRATION_MS=600000    # 10 minutes

# --- CORS ---
# Empty = same-origin only, which is correct behind the bundled nginx.
# Set only if a browser on another origin must call the API directly:
#   APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://*.trycloudflare.com
APP_CORS_ALLOWED_ORIGIN_PATTERNS=
