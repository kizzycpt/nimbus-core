# Copy to .env and fill in — or just run ./run.sh, which generates a .env
# with strong random secrets on first run.
#
# .env holds live credentials and is gitignored. Never commit it.

# --- Postgres (runs in its own container, never exposed to the host) ---
POSTGRES_DB=nimbus
POSTGRES_USER=nimbus
POSTGRES_PASSWORD=          # >= 16 chars, generated. Do not reuse a personal password.

# --- Browser sessions ---
# Idle timeout for the session cookie, in minutes. The window slides forward on
# every authenticated request, so this is not a hard cap on how long you stay in.
APP_SESSION_TTL_MINUTES=720          # 12 hours

# Adds Secure to the session and CSRF cookies, so they never travel over plain
# HTTP. Leave false for localhost; set true the moment a TLS front end is in
# place (cloudflared, Caddy, tailscale serve, ...).
APP_SECURE_COOKIES=false

# --- Password hashing ---
# BCrypt work factor, as log2 of the round count. 12 is the modern default and
# costs roughly 250ms per hash on x86 — that cost is the point, it is what makes
# offline cracking expensive. Drop to 10 on a low-power ARM board if logins feel
# sluggish. Never go below 10. Existing hashes keep working when you change it.
APP_BCRYPT_STRENGTH=12

# --- JWT (bearer tokens for scripts and CI only; browsers use cookies) ---
JWT_SECRET=                 # >= 32 chars for HS256. Rotating this invalidates all issued tokens.
JWT_EXPIRATION_MS=600000    # 10 minutes

# --- Website hosting (the storage product) ---
# Where customer site files live on the HOST. Point this at your data disk or
# flash drive. The filesystem must support Unix ownership: ext4 or xfs, never
# exFAT/FAT32. run.sh reads this directory's owner and runs the backend as that
# UID, writing NIMBUS_UID/NIMBUS_GID back into .env.
NIMBUS_SITES_DIR=./data/sites

# Storage sold per account, across all of their sites (bytes). 100MB default.
# Raise it for one customer with a SQL update rather than changing this.
APP_SITES_QUOTA_BYTES=104857600

# Ceiling on any single upload (bytes). 10MB default.
APP_SITES_MAX_FILE_BYTES=10485760

# How many separate websites one account may create.
APP_SITES_MAX_PER_USER=3

# --- CORS ---
# Empty = same-origin only, which is correct behind the bundled nginx.
# Set only if a browser on another origin must call the API directly:
#   APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://*.trycloudflare.com
APP_CORS_ALLOWED_ORIGIN_PATTERNS=
